<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>   <!-- Скрываем консольное окно -->
    <TargetFramework>net10.0-windows</TargetFramework>  <!-- Обязательно с -windows -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>   <!-- Нужно для WebView2 -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>